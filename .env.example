# VehicleGPT Backend Environment Variables
PROJECT_NAME=VehicleGPT API
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_PREFIX=/api
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite default under backend/data/vehicle.db)
DATABASE_URL=sqlite:///./data/vehicle.db
