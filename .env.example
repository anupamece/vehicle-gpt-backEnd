# VehicleGPT Backend Environment Variables
PROJECT_NAME=VehicleGPT API
ENVIRONMENT=development
DEBUG=True

# API Configuration
API_PREFIX=/api
DOCS_URL=/docs
OPENAPI_URL=/openapi.json

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (SQLite default under backend/data/vehicle.db)
DATABASE_URL=sqlite:///./data/vehicle.db

# LLM Provider: 'groq' for ultra-fast cloud, or 'ollama' for offline local
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=60.0
OLLAMA_KEEP_ALIVE=5m

# Cloud Groq Configuration (Option 1 - 24/7 Zero Cost Hosting)
# Set LLM_PROVIDER=groq and paste your free Groq API key (starts with gsk_)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=30.0
